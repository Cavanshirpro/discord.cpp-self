{
  "version": 6,
  "configurePresets": [
    {
      "name": "mingw64",
      "displayName": "MSYS2 MINGW64 (Windows)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_CXX_COMPILER": "C:/msys64/mingw64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/mingw64/bin/ninja.exe",
        "CMAKE_PREFIX_PATH": "C:/msys64/mingw64"
      }
    },
    {
      "name": "default",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_EXPORT_COMPILE_COMMANDS": true }
    }
  ],
  "buildPresets": [
    { "name": "mingw64", "configurePreset": "mingw64" },
    { "name": "default", "configurePreset": "default" }
  ],
  "testPresets": [
    { "name": "mingw64", "configurePreset": "mingw64", "output": { "outputOnFailure": true } },
    { "name": "default", "configurePreset": "default", "output": { "outputOnFailure": true } }
  ]
}

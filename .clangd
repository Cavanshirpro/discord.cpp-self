CompileFlags:
  # GCC may default to C++20 and omit -std from compile_commands.json, while
  # clangd still defaults to C++17. Keep the editor on this project's standard.
  Add: [-std=c++20, -fparse-all-comments, -fretain-comments-from-system-headers]
Documentation:
  CommentFormat: Doxygen
